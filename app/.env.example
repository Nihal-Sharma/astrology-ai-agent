# Base URL for the astrology-ai-agent server (../server).
#
# The default in src/config.ts already handles the iOS
# simulator/web vs Android emulator "localhost" difference, so
# you only need to set this when:
#  - the server is running on a non-default port (check
#    ../server/.env's PORT — the documented default is 3000)
#  - you're testing on a physical device over Wi-Fi, where
#    "localhost" doesn't resolve to your dev machine at all —
#    use your machine's LAN IP instead, e.g.:
#    EXPO_PUBLIC_API_URL=http://192.168.1.23:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
