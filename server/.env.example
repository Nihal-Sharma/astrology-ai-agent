PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

APP_NAME=astrology-ai-agent
HOST=0.0.0.0

MONGO_URI=
REDIS_URL=

# LLM_API_KEY is OpenAI's key — required regardless of the providers below,
# since embeddings (further down) always use OpenAI no matter what.
LLM_API_KEY=

# GEMINI_API_KEY is required as soon as any *_PROVIDER below is "gemini"
# (the default for all three) — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# "openai" or "gemini" per provider — defaults below assume gemini for
# LLM/STT/TTS. Embeddings are NOT configurable here; they're OpenAI-only
# by deliberate choice, see EMBEDDING_PROVIDER further down.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
# Used for small/latency-sensitive helper calls (transcript display-
# translation, the agent planner's routing decision) that don't need a
# full conversational model.
LLM_FAST_MODEL=gemini-3.1-flash-lite
# OpenAI-only — ignored entirely if LLM_PROVIDER=gemini. Only relevant if
# LLM_MODEL is a reasoning model (gpt-5/o-series); trims its "thinking"
# time before the first output token. Leave unset for a non-reasoning
# model — OpenAI rejects this param outright for those. One of: none,
# minimal, low, medium, high, xhigh, max.
# LLM_RESPONSE_REASONING_EFFORT=low

STT_PROVIDER=gemini
TTS_PROVIDER=gemini
# gemini-3.5-transcribe requires an upload-then-transcribe round trip per
# call (see GeminiSttClient) — a real added latency vs. OpenAI's single-call
# STT, accepted deliberately alongside the ROADMAP.md latency work.
STT_MODEL=gemini-3.5-transcribe
TTS_MODEL=gemini-3.1-flash-tts-preview

# TTS_VOICE: a Gemini prebuilt voice name (e.g. Kore, Puck) when
# TTS_PROVIDER=gemini — NOT an OpenAI voice id, these don't carry over.
# For TTS_PROVIDER=openai, use one of OpenAI's own voices instead (alloy/
# ash/ballad/coral/echo/fable/onyx/nova/sage/shimmer/verse/marin/cedar).
# TTS_INSTRUCTIONS: delivery/style/accent guidance. Gemini TTS has no
# separate instructions parameter — this gets prefixed onto the spoken
# text itself instead (see GeminiTtsClient.toStyledInput), untested
# against a live key. For OpenAI, only gpt-4o-mini-tts honors this.
TTS_VOICE=Kore
TTS_INSTRUCTIONS=Speak as a warm, friendly Indian woman with a natural Indian English accent. Gentle, conversational pacing — like a trusted friend, not a formal announcer.
# TTS_SPEED: OpenAI only (0.25-4.0, 1.0 is normal) — no confirmed numeric
# speed control in Gemini's TTS API, GeminiTtsClient ignores this.
TTS_SPEED=1.2

# Deliberately always OpenAI, regardless of LLM/STT/TTS_PROVIDER above.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_STORE=pgvector

ASTROLOGY_MCP_SERVER_URL=
ASTROLOGY_MCP_API_KEY=
MCP_REQUEST_TIMEOUT_MS=5000

ENABLE_MEMORY=true
ENABLE_RAG=true
ENABLE_MCP=true

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_PER_MINUTE=20
